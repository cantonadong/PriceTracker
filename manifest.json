{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "价格守望",
  "version": "1.1",
  "key": "RAA6AFwARABlAHYAXABQAHIAaQBjAGUAVAByAGEAYwBrAGUAcgA=",
  "description": "选择网页上的价格，按小时检查并在降到目标价时提醒。",
  "permissions": ["storage", "alarms", "tabs", "scripting", "offscreen", "notifications", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" },
  "action": { "default_title": "价格守望", "default_popup": "popup.html", "default_icon": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" } },
  "options_page": "dashboard.html",
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["price-reader.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
